# Copia a .env: cp .env.example .env

ROS2_BASE_IMAGE=osrf/ros:foxy-ros-base
# Apple Silicon (ejemplo): ROS2_BASE_IMAGE=arm64v8/ros:foxy-ros-base

ROS_MASTER_HOSTNAME=robot_p3at_sim_ros1
ROS_DOMAIN_ID=0

# Robot simulado solo en ROS 1 (prefijo de tópicos en el master Noetic).
ROBOT_ROS1_NAMESPACE=p3at_sim_1
# Robot simulado solo en ROS 2 (prefijo en el grafo Foxy).
ROBOT_ROS2_NAMESPACE=p3at_sim_2

STRATEGY=square
