<?xml version="1.0"?>

<robot
  name="go2"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================== -->
  <!-- ARGUMENTS -->
  <!-- ===================================================== -->

  <xacro:arg name="robot_namespace" default="go2_sim"/>

  <!-- ===================================================== -->
  <!-- MATERIALS -->
  <!-- ===================================================== -->

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ===================================================== -->
  <!-- BODY -->
  <!-- ===================================================== -->

  <link name="base_link">

    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.60 0.30 0.20"/>
      </geometry>

      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.60 0.30 0.20"/>
      </geometry>
    </collision>

  </link>

  <!-- ===================================================== -->
  <!-- LEGS -->
  <!-- ===================================================== -->

  <xacro:macro name="leg_link" params="name">

    <link name="${name}">

      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>

        <inertia
          ixx="0.001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.001"
          iyz="0.0"
          izz="0.001"/>
      </inertial>

      <visual>
        <geometry>
          <cylinder radius="0.03" length="0.30"/>
        </geometry>

        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.03" length="0.30"/>
        </geometry>
      </collision>

    </link>

  </xacro:macro>

  <xacro:leg_link name="front_left_leg"/>
  <xacro:leg_link name="front_right_leg"/>
  <xacro:leg_link name="rear_left_leg"/>
  <xacro:leg_link name="rear_right_leg"/>

  <!-- ===================================================== -->
  <!-- FIXED JOINTS -->
  <!-- ===================================================== -->

  <joint name="front_left_leg_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_leg"/>
    <origin xyz="0.2 0.15 -0.2"/>
  </joint>

  <joint name="front_right_leg_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_leg"/>
    <origin xyz="0.2 -0.15 -0.2"/>
  </joint>

  <joint name="rear_left_leg_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_leg"/>
    <origin xyz="-0.2 0.15 -0.2"/>
  </joint>

  <joint name="rear_right_leg_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_leg"/>
    <origin xyz="-0.2 -0.15 -0.2"/>
  </joint>
   <!-- ===================================================== -->
  <!-- GAZEBO DIFF DRIVE -->
  <!-- ===================================================== -->

  <gazebo>

    <plugin
      name="go2_drive_controller"
      filename="libgazebo_ros_planar_move.so">

      <robotNamespace>/go2_sim_1</robotNamespace>

      <commandTopic>cmd_vel</commandTopic>

      <odometryTopic>odom</odometryTopic>

      <odometryFrame>odom</odometryFrame>

      <robotBaseFrame>base_link</robotBaseFrame>

      <publishTF>true</publishTF>

      <updateRate>50.0</updateRate>

    </plugin>

  </gazebo>

</robot>