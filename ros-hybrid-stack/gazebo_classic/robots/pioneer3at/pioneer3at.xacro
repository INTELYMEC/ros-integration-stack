<?xml version="1.0"?>

<robot
  name="pioneer3at"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================== -->
  <!-- ARGUMENTS -->
  <!-- ===================================================== -->

  <xacro:arg name="robot_namespace" default="p3at_sim"/>

  <!-- ===================================================== -->
  <!-- MATERIALS -->
  <!-- ===================================================== -->

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- ===================================================== -->
  <!-- BASE -->
  <!-- ===================================================== -->

  <link name="base_link">

    <inertial>
      <mass value="14.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.50 0.40 0.25"/>
      </geometry>

      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.50 0.40 0.25"/>
      </geometry>
    </collision>

  </link>

  <!-- ===================================================== -->
  <!-- WHEELS -->
  <!-- ===================================================== -->

  <xacro:macro name="wheel_link" params="name">

    <link name="${name}">

      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>

        <inertia
          ixx="0.001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.001"
          iyz="0.0"
          izz="0.001"/>
      </inertial>

      <visual>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>

        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>
      </collision>

    </link>

  </xacro:macro>

  <xacro:wheel_link name="left_front_wheel"/>
  <xacro:wheel_link name="right_front_wheel"/>
  <xacro:wheel_link name="left_rear_wheel"/>
  <xacro:wheel_link name="right_rear_wheel"/>

  <!-- ===================================================== -->
  <!-- JOINTS -->
  <!-- ===================================================== -->

  <joint name="left_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.20 0.25 -0.10" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.20 -0.25 -0.10" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="left_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.20 0.25 -0.10" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.20 -0.25 -0.10" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================================================== -->
  <!-- GAZEBO PLUGIN -->
  <!-- ===================================================== -->

  <gazebo>
    <plugin
      name="skid_steer_drive_controller"
      filename="libgazebo_ros_skid_steer_drive.so">

      <robotNamespace>/$(arg robot_namespace)</robotNamespace>

      <updateRate>50.0</updateRate>

      <leftFrontJoint>left_front_joint</leftFrontJoint>
      <rightFrontJoint>right_front_joint</rightFrontJoint>

      <leftRearJoint>left_rear_joint</leftRearJoint>
      <rightRearJoint>right_rear_joint</rightRearJoint>

      <wheelSeparation>0.5</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>

      <torque>20</torque>

      <robotBaseFrame>base_link</robotBaseFrame>

      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>

      <odometryFrame>odom</odometryFrame>

      <broadcastTF>true</broadcastTF>

      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>

    </plugin>
  </gazebo>

</robot>