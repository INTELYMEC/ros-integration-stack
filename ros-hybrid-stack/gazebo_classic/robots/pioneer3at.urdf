<?xml version="1.0"?>
<robot name="pioneer3at">

  <link name="p3at_sim_1/base_link">
    <inertial>
      <mass value="14.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.50 0.40 0.25"/>
      </geometry>
      <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <box size="0.50 0.40 0.25"/>
      </geometry>
    </collision>
  </link>

  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>

  <link name="left_front_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual><geometry><cylinder length="0.05" radius="0.1"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.1"/></geometry></collision>
  </link>

  <link name="right_front_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual><geometry><cylinder length="0.05" radius="0.1"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.1"/></geometry></collision>
  </link>

  <link name="left_rear_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual><geometry><cylinder length="0.05" radius="0.1"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.1"/></geometry></collision>
  </link>

  <link name="right_rear_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual><geometry><cylinder length="0.05" radius="0.1"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.1"/></geometry></collision>
  </link>

  <joint name="left_front_joint" type="continuous">
    <parent link="p3at_sim_1/base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.2 0.25 -0.1" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_front_joint" type="continuous">
    <parent link="p3at_sim_1/base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.2 -0.25 -0.1" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="left_rear_joint" type="continuous">
    <parent link="p3at_sim_1/base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.2 0.25 -0.1" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_rear_joint" type="continuous">
    <parent link="p3at_sim_1/base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.2 -0.25 -0.1" rpy="1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo>
    <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
      <updateRate>50.0</updateRate>
      <robotNamespace>/</robotNamespace>
      <leftFrontJoint>left_front_joint</leftFrontJoint>
      <rightFrontJoint>right_front_joint</rightFrontJoint>
      <leftRearJoint>left_rear_joint</leftRearJoint>
      <rightRearJoint>right_rear_joint</rightRearJoint>
      <wheelSeparation>0.5</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>
      <robotBaseFrame>p3at_sim_1/base_link</robotBaseFrame>
      <commandTopic>p3at_sim_1/cmd_vel</commandTopic>
      <odometryTopic>p3at_sim_1/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <broadcastTF>true</broadcastTF>
    </plugin>
  </gazebo>
</robot>