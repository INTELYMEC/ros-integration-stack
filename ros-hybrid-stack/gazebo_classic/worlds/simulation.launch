<launch>
  <arg name="world_file" default="pioneer_world.world"/>
  <arg name="robot_file" default="/root/robots/pioneer3at.urdf"/>
  <arg name="robot_name" default="pioneer3at"/>
  <arg name="gui"        default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="/root/worlds/$(arg world_file)"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="verbose" value="true"/>
  </include>

  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model" 
        args="-file $(arg robot_file) -urdf -model $(arg robot_name) -x 0 -y 0 -z 0.1" 
        output="screen"/>
</launch>